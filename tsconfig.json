{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "agent/**/*.ts", "evaluation/**/*.ts", "scripts/**/*.ts"]
}
